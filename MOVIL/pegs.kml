	<ExtendedData><SchemaData schemaUrl="#propuesta_v1">
		<SimpleData name="fid">4</SimpleData>
		<SimpleData name="id">4</SimpleData>
		<SimpleData name="observaciones">Con el objetivo de mejorar la defensa de bienes y personas. Se propone una reducción de combustible mediante desbroce, si es posible transición a modelos de pasto.</SimpleData>
		<SimpleData name="tipo">Defensivo</SimpleData>
		<SimpleData name="vegetacion">Forestal no arbolado</SimpleData>
	</SchemaData></ExtendedData>
