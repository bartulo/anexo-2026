  <Placemark>
	<Style><LineStyle><color>ff0000ff</color></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#propuesta_v1">
		<SimpleData name="fid">1</SimpleData>
		<SimpleData name="id">1</SimpleData>
		<SimpleData name="observaciones">Si el fuego llega a este punto en condiciones de viento sur se produce alineación de factores (Campbell) y cambiaría el comportamiento del incendio a más virulento. Se propne reducir la carga de combustible mediante desbroces y apeos y mantener la FCC en pies superiores a 4 metros. </SimpleData>
		<SimpleData name="tipo">Punto crítico, cabecera de barranco</SimpleData>
		<SimpleData name="vegetacion">Pino carrasco y matorral mediteráneo</SimpleData>
	</SchemaData></ExtendedData>
