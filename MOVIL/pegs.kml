	<ExtendedData><SchemaData schemaUrl="#propuesta_v1">
		<SimpleData name="fid">9</SimpleData>
		<SimpleData name="id">9</SimpleData>
		<SimpleData name="observaciones">Con el objetivo de mejorar la defensa de bienes y personas. Se propone una reducción de la continuidad vertical mediante desbroce y poda y reducción de FCC mediante apeos en aquellas zonas que se encuentren a menos de 10 metros de edificaciones</SimpleData>
		<SimpleData name="tipo">Defensivo</SimpleData>
		<SimpleData name="vegetacion">Pino carrasco</SimpleData>
	</SchemaData></ExtendedData>
