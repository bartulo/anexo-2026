  <Placemark>
	<Style><LineStyle><color>ff0000ff</color></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#propuesta_v1">
		<SimpleData name="fid">6</SimpleData>
		<SimpleData name="id">6</SimpleData>
		<SimpleData name="observaciones">El fuego si llega a este punto tiene potencial de dividirse y quemar dos cuencas diferentes. Se propne reducir la carga de combustible mediante desbroces y apeos y mantener la FCC en pies superiores a 4 metros. El objetivo es reducir el paveseo y la virulencia del incendio cuando llegue a este punto. Analizar zona SW por si se considera oportuno llevar a evolución natural.</SimpleData>
		<SimpleData name="tipo">Punto crítico, nudo de barranco</SimpleData>
		<SimpleData name="vegetacion">Masa de quejigo</SimpleData>
	</SchemaData></ExtendedData>
      <MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>-1.37615933791545,42.6154669518304 -1.37448329520605,42.6152465774624 -1.37460355536661,42.6157397862491 -1.37458031743721,42.6166330966843 -1.37431229632507,42.6163943409203 -1.37429414396624,42.6163519541235 -1.37423798353525,42.6163703951498 -1.37418623200616,42.616382818413 -1.37418525968478,42.6163830518243 -1.37418086545215,42.6163842142175 -1.37411744756952,42.6164009899364 -1.37405048305409,42.6164216979861 -1.37405048436216,42.6164216910225 -1.37405047448279,42.6164216940766 -1.37404586443577,42.6164461692353 -1.3740460073401,42.6164464791641 -1.3739918535763,42.616463889163 -1.37374646947015,42.6165944514554 -1.3731238172285,42.6163443264523 -1.37291541560277,42.6159839101676 -1.37311707186899,42.6156740005182 -1.37326057866378,42.615273900624 -1.37341152731064,42.6150526342669 -1.37335907737111,42.6147435834985 -1.37343222426619,42.6144899347563 -1.37377981925367,42.6141508187764 -1.37393983567797,42.6140458536756 -1.37418997808619,42.6139645086557 -1.37475737336719,42.6142451212838 -1.37492635354744,42.6144932699793 -1.3753011738744,42.6147354019293 -1.3758141556893,42.6150152374772 -1.37649564171333,42.6150963901424 -1.37615933791545,42.6154669518304</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry>
