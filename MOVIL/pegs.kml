  <Placemark>
	<Style><LineStyle><color>ff0000ff</color></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#propuesta_v1">
		<SimpleData name="fid">5</SimpleData>
		<SimpleData name="id">5</SimpleData>
		<SimpleData name="observaciones">El fuego cuando llegue a esta zona cambiará de comportamiento tanto en incendios con condiciones de viento norte como incendios con condiciones de viento sur. Deja de haber alineación de factores (Campbell) y puede constituir una zona actuación para los equipos de extinción. Se propone la ejecución de una faja perimetral de 60 metros de ancho con reducción de FCC y reducción de carga de combustible con un desbrocce inicial y un mantenimiento posterior usando pastoreo.</SimpleData>
		<SimpleData name="tipo">Defensivo</SimpleData>
		<SimpleData name="vegetacion">Masa de Quejigo</SimpleData>
	</SchemaData></ExtendedData>
      <MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>-1.34935974502357,42.6233131741241 -1.34864030821996,42.6226057659382 -1.34751988298956,42.6224198152752 -1.34670016574216,42.6218449937963 -1.34536084105863,42.6214726662444 -1.34387674144607,42.621084825227 -1.34247127721766,42.6204702252098 -1.34121975964591,42.6197550691472 -1.34086710575678,42.6189099411792 -1.33910578165248,42.6173473557688 -1.33871655955031,42.6168388680613 -1.33874709816215,42.6168191404179 -1.33877986666804,42.6167625209632 -1.33880488946096,42.6167193532541 -1.33881630504906,42.6166996597953 -1.33881626361176,42.6166996330546 -1.33875441723719,42.6166419240033 -1.33909979395132,42.6164841868491 -1.3391389412852,42.6165215745172 -1.33931759318005,42.6166625019782 -1.33946648680228,42.616754172344 -1.33958384351196,42.6168107887506 -1.33961244340549,42.6168203566936 -1.33967150111071,42.6168217779539 -1.34148798596281,42.6183112589573 -1.34222176444205,42.6193853116153 -1.34368437160425,42.6203537282711 -1.34540502441379,42.6207181800812 -1.34786593715006,42.6214596779973 -1.34912741976944,42.6222598007666 -1.34977898326144,42.6228676736017 -1.34977742552563,42.6228964812294 -1.34977729820999,42.6228987958245 -1.34977729614144,42.6228988392855 -1.34977780113897,42.622939265641 -1.34978103841471,42.6229796443653 -1.3497861805766,42.6230142181892 -1.34978702297357,42.6230198855801 -1.34978703130155,42.6230199147623 -1.34979900369546,42.623059393821 -1.34981359293504,42.6230982887685 -1.34981360758592,42.6230983269836 -1.34983081478013,42.6231365686569 -1.34985054494971,42.6231740479329 -1.34985887391979,42.6231877895785 -1.34935974502357,42.6233131741241</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry>
