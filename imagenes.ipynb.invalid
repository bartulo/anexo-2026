    "## ALTITUD"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e3a41f73-98c0-472c-a64a-93e8c2b9d868",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import geopandas as gpd\n",
    "from cartopy import crs as ccrs\n",
    "from matplotlib import pyplot as plt\n",
    "import numpy as np\n",
    "from osgeo import gdal\n",
    "from matplotlib.colors import LightSource\n",
    "\n",
    "ls = LightSource()\n",
    "ds = gdal.Open('mdt_.tif')\n",
    "gt = ds.GetGeoTransform()\n",
    "data = ds.ReadAsArray()\n",
    "\n",
    "ys, xs = data.shape\n",
    "ulx, xres, _, uly, _, yres = gt\n",
    "extent = [ulx, ulx+xres*xs, uly, uly+yres*ys]\n",
    "print(data)\n",
    "fig = plt.figure(figsize=(16,12))\n",
    "ax = plt.axes(projection=proj)\n",
    "\n",
    "ax.set_extent([minx - buffer, maxx + buffer, miny - buffer, maxy + buffer], crs=proj)\n",
    "# ax.add_wms(wms='https://servicios.idee.es/wms-inspire/mdt', layers=['EL.ElevationGridCoverage'], styles='Elevaciones')\n",
    "municipio.plot(ax=ax, facecolor=(1,0,0,0.1), edgecolor='black', linewidth=3)\n",
    "ax.imshow(ls.hillshade(data), extent=extent, origin='lower', cmap='gray', alpha=0.4)\n",
    "im = ax.imshow(data, extent=extent, origin='lower', cmap=plt.cm.gist_earth, alpha=0.7)\n",
    "cb = fig.colorbar(im, shrink=.5)\n",
    "plt.savefig('FINALES/OROGRAFIA/altitud.png', bbox_inches='tight')"
   ]
  },
