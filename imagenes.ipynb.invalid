   "source": [
    "forestal = cultivos[(cultivos.GRUPO == 'Forestal no arbolado') | (cultivos.GRUPO == 'Coníferas') | (cultivos.GRUPO == 'Coníferas/Frondosas') | (cultivos.GRUPO == 'Frondosas') ]\n",
    "agraria = cultivos[(cultivos.GRUPO == 'Cultivos leñosos regadío') | (cultivos.GRUPO == 'Cultivos leñosos secano') | (cultivos.GRUPO == 'Cultivos herbáceos regadío') | (cultivos.GRUPO == 'Cultivos herbáceos secano') ]\n",
    "industria = cultivos[(cultivos.COBERTURAP == 'POLÍGONO INDUSTRIAL ORDENADO') | (cultivos.COBERTURAP == 'POLÍGONO INDUSTRIAL SIN ORDENAR') | (cultivos.COBERTURAP == 'INDUSTRIA AISLADA')]"
