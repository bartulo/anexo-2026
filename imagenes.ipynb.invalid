   "source": [
    "import clim_temp_media\n",
    "import importlib\n",
    "import os\n",
    "\n",
    "importlib.reload(clim_temp_media)\n",
    "\n",
    "c = clim_temp_media.Climograma('San Martín de Unx')\n",
    "c.create_df()\n",
    "c.draw_climodiagrama()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2e14e2e8-ec72-40b0-8fb5-a6c65a022e25",
   "metadata": {
    "scrolled": true,
    "tags": []
   },
   "outputs": [],
   "source": [
    "datos = c.datos_anuales\n",
    "for i in range(2005, 2023):\n",
    "    draw_climodiagrama(datos, i)"
   ]
  },
